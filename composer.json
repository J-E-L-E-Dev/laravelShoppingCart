{
    "name": "edwinylil1/laravelshoppingcart",
    "description": "Laravel Shopping cart VE",
    "keywords": ["laravel", "shoppingcart", "ve"],
    "license": "MIT",
    "authors": [
        {
            "name": "Edwin J. Villegas M.",
            "email": "devvillegas@proton.me",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/collections": "^10.0 || ^11.0",
        "illuminate/support": "^10.0 || ^11.0",
        "illuminate/session": "^10.0 || ^11.0",
        "illuminate/events": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "JeleDev\\Shoppingcart\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "JeleDev\\Shoppingcart\\ShoppingcartServiceProvider"
            ],
            "aliases": {
                "Cart": "JeleDev\\Shoppingcart\\Facades\\Cart"
            }
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "illuminate/database": "^10.0 || ^11.0",
        "illuminate/config": "^10.0 || ^11.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "scripts": {"test": "phpunit"}
}
